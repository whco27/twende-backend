# ============================================================
# Twende Tours Backend - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# For integrated deployment (frontend + backend on same server),
# see the Integration Guide section below.
# ============================================================

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================================
# Database Configuration
# ============================================================
# PostgreSQL connection string - used by backend, frontend, and daraja
# All components share the same database for unified data access
#
# For Railway deployment:
#   Railway automatically injects DATABASE_URL when you add PostgreSQL.
#   DO NOT manually set DATABASE_URL in Railway's environment variables
#   dashboard - Railway handles this automatically and overriding it
#   may cause connection issues.
#
# For local development:
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/twende_tours

# Auto-seed tours on startup when database is empty
# Set to 'false' to disable auto-seeding (useful for production if you
# want to manually manage tour data)
AUTO_SEED_TOURS=true

# ============================================================
# Frontend Integration Configuration
# ============================================================
# For INTEGRATED deployment (frontend served from backend):
#   - Set ENABLE_CORS=false
#   - Deploy frontend build to public/ directory
#   - Run: ./scripts/deploy_frontend.sh /path/to/frontend
#
# For SEPARATE deployment (frontend on different server/domain):
#   - Set ENABLE_CORS=true
#   - Set FRONTEND_URL to your frontend domain(s)
#   - Frontend should use REACT_APP_API_URL or VITE_API_URL
#     to point to your backend URL
#
# Railway/Netlify/Vercel example:
#   Backend on Railway: https://twende-backend.up.railway.app
#   Frontend on Netlify: https://twende-tours.netlify.app
#   Set FRONTEND_URL=https://twende-tours.netlify.app
#   Frontend .env: REACT_APP_API_URL=https://twende-backend.up.railway.app
ENABLE_CORS=true
# Frontend URLs for CORS (comma-separated for multiple origins)
# Only used when ENABLE_CORS=true
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ============================================================
# Server Configuration
# ============================================================
HOST=0.0.0.0
PORT=5000

# ============================================================
# Email Configuration for Notifications
# ============================================================
# These settings enable email notifications for:
# - User registration confirmation
# - Admin alerts for new registrations
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@twendetours.com

# Admin emails for new user registration notifications (comma-separated)
ADMIN_EMAILS=admin@twendetours.com

# ============================================================
# M-Pesa Daraja API Configuration
# ============================================================
# Get these from the Safaricom Daraja Developer Portal:
# https://developer.safaricom.co.ke/
#
# The Daraja integration provides:
# - STK Push payment initiation
# - Payment status callbacks
# - Transaction verification
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret
DARAJA_PASSKEY=your_passkey
DARAJA_SHORTCODE=174379
# Callback URL must be publicly accessible
# For Railway: https://your-backend.up.railway.app/api/payments/callback
DARAJA_CALLBACK_URL=https://your-backend-url.com/api/payments/callback

# ============================================================
# Railway Deployment Quick Reference
# ============================================================
# Railway automatically sets these when you add services:
#   - DATABASE_URL: Set when you add PostgreSQL
#   - PORT: Set automatically
#
# Required environment variables to set in Railway dashboard:
#   - SECRET_KEY (generate a secure random string)
#   - FLASK_ENV=production
#   - ENABLE_CORS=true (if frontend is on different domain)
#   - FRONTEND_URL (your frontend's deployed URL)
#
# Optional (if using features):
#   - MAIL_* variables for email notifications
#   - DARAJA_* variables for M-Pesa payments

# ============================================================
# Frontend Environment Variables Reference
# ============================================================
# When building a separate frontend (React, Vue, etc.), set:
#
# React (.env):
#   REACT_APP_API_URL=https://your-backend.up.railway.app
#
# Vue/Vite (.env):
#   VITE_API_URL=https://your-backend.up.railway.app
#
# Then in your frontend code:
#   const API_URL = process.env.REACT_APP_API_URL || '';
#   fetch(`${API_URL}/api/auth/register`, { ... })

# ============================================================
# Integration Quick Start
# ============================================================
# 1. For local development with separate frontend:
#    ENABLE_CORS=true
#    FRONTEND_URL=http://localhost:5173
#
# 2. For production with integrated frontend:
#    ENABLE_CORS=false
#    ./scripts/deploy_frontend.sh ../twende-frontend
#
# 3. For production with separate frontend (Railway + Netlify):
#    ENABLE_CORS=true
#    FRONTEND_URL=https://your-frontend.netlify.app
#
# 4. Ensure Daraja callback URL is publicly accessible
#
# 5. All components (frontend, daraja, backend) use the same
#    DATABASE_URL for unified data access